set(RP2040_133MHZ_DEFINITIONS
    "-DSYS_CLK_KHZ=133000 -DPLL_SYS_VCO_FREQ_KHZ=1596000 -DPLL_SYS_POSTDIV1=6 -DPLL_SYS_POSTDIV2=2"
)
set(RP2040_TOOLCHAIN_FLAGS
    "-mcpu=cortex-m0plus -mthumb ${RP2040_133MHZ_DEFINITIONS}"
)

set(CMAKE_C_FLAGS
    "${RP2040_TOOLCHAIN_FLAGS}"
    CACHE STRING "C flags for the 133 MHz RP2040 benchmark" FORCE
)
set(CMAKE_CXX_FLAGS
    "${RP2040_TOOLCHAIN_FLAGS}"
    CACHE STRING "C++ flags for the 133 MHz RP2040 benchmark" FORCE
)
set(CMAKE_ASM_FLAGS
    "${RP2040_TOOLCHAIN_FLAGS}"
    CACHE STRING "ASM flags for the 133 MHz RP2040 benchmark" FORCE
)
